<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ConstanceSaveEditor.UI.ViewModels"
        xmlns:editors="using:ConstanceSaveEditor.UI.ViewModels.Editors"
        xmlns:b="using:ConstanceSaveEditor.UI.Behaviors"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="ConstanceSaveEditor.UI.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Width="1200" Height="800"
        MinWidth="600" MinHeight="400">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
    </Window.KeyBindings>

    <DockPanel>

        <!-- Menu bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open..."
                          Command="{Binding OpenCommand}"
                          InputGesture="Ctrl+O" />
                <MenuItem Header="_Save"
                          Command="{Binding SaveCommand}"
                          InputGesture="Ctrl+S" />
                <MenuItem Header="Save _As..."
                          Command="{Binding SaveAsCommand}"
                          InputGesture="Ctrl+Shift+S" />
                <Separator />
                <MenuItem Header="Recent _Files"
                          IsEnabled="{Binding HasRecentFiles}"
                          ItemsSource="{Binding RecentFiles}" />
                <Separator />
                <MenuItem Header="_Close"
                          Command="{Binding CloseCommand}" />
                <Separator />
                <MenuItem Header="E_xit"
                          Command="{Binding ExitCommand}" />
            </MenuItem>
        </Menu>

        <!-- Status bar -->
        <Grid DockPanel.Dock="Bottom"
              ColumnDefinitions="*,Auto"
              Margin="8,4">
            <TextBlock Grid.Column="0"
                       Text="{Binding FileStatusText}"
                       FontSize="12"
                       Opacity="0.7"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1"
                       Text="{Binding StatusMessage}"
                       FontSize="12"
                       Margin="16,0,0,0" />
        </Grid>

        <!-- Main content -->
        <Grid>

            <!-- No file open -->
            <StackPanel IsVisible="{Binding NoFileOpen}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">
                <TextBlock Text="No save file open"
                           FontSize="20"
                           Opacity="0.5"
                           HorizontalAlignment="Center" />
                <TextBlock Text="File &#x2192; Open  or  Ctrl+O"
                           FontSize="14"
                           Opacity="0.35"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Editor -->
            <ContentControl IsVisible="{Binding HasOpenFile}"
                            Content="{Binding CurrentEditor}">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:SaveEditorViewModel">
                        <DockPanel>

                            <!-- Info strip -->
                            <Border DockPanel.Dock="Top"
                                    Padding="12,8,12,8"
                                    BorderThickness="0,0,0,1"
                                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{Binding SourcePath}"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding SourcePath}" />
                                        <StackPanel Orientation="Horizontal" Spacing="16">
                                            <TextBlock Text="{Binding FormatDisplay}"
                                                       FontSize="12"
                                                       Opacity="0.6" />
                                            <TextBlock Text="{Binding LoadedAtDisplay}"
                                                       FontSize="12"
                                                       Opacity="0.6" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="Revert"
                                            Command="{Binding RevertCommand}"
                                            IsEnabled="{Binding IsDirty}"
                                            VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Tabs -->
                            <TabControl>

                                <!-- Player tab -->
                                <TabItem Header="Player">
                                    <ScrollViewer Padding="16">
                                        <StackPanel Spacing="20" MaxWidth="480" HorizontalAlignment="Left">

                                            <!-- Currency section -->
                                            <TextBlock Text="Currency (Glimmer)"
                                                       FontSize="15"
                                                       FontWeight="SemiBold" />

                                            <Grid RowDefinitions="Auto,Auto,Auto"
                                                  ColumnDefinitions="160,*"
                                                  RowSpacing="10">

                                                <TextBlock Grid.Row="0" Grid.Column="0"
                                                           Text="Balance"
                                                           VerticalAlignment="Center" />
                                                <NumericUpDown Grid.Row="0" Grid.Column="1"
                                                               Value="{Binding PlayerEditor.Balance}"
                                                               Minimum="0"
                                                               Increment="1000"
                                                               FormatString="0" />

                                                <TextBlock Grid.Row="1" Grid.Column="0"
                                                           Text="Total Collected"
                                                           VerticalAlignment="Center" />
                                                <NumericUpDown Grid.Row="1" Grid.Column="1"
                                                               Value="{Binding PlayerEditor.TotalCollected}"
                                                               Minimum="0"
                                                               Increment="1000"
                                                               FormatString="0" />

                                                <TextBlock Grid.Row="2" Grid.Column="0"
                                                           Text="All-Time Glimmer"
                                                           VerticalAlignment="Center" />
                                                <NumericUpDown Grid.Row="2" Grid.Column="1"
                                                               Value="{Binding PlayerEditor.AllTimeGlimmer}"
                                                               Minimum="0"
                                                               Increment="1000"
                                                               FormatString="0" />
                                            </Grid>

                                            <TextBlock Text="Total Collected must be ≥ Balance. Both are raised automatically if needed."
                                                       FontSize="11"
                                                       Opacity="0.5"
                                                       TextWrapping="Wrap" />

                                            <Button Content="Apply Changes"
                                                    Command="{Binding PlayerEditor.ApplyChangesCommand}" />

                                            <TextBlock Text="{Binding PlayerEditor.ValidationMessage}"
                                                       FontSize="12"
                                                       Foreground="Orange"
                                                       IsVisible="{Binding PlayerEditor.ValidationMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                       TextWrapping="Wrap" />

                                            <!-- Separator -->
                                            <Border Height="1"
                                                    Background="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                                    Margin="0,4" />

                                            <!-- Player stats section -->
                                            <TextBlock Text="Player Stats"
                                                       FontSize="15"
                                                       FontWeight="SemiBold" />

                                            <Grid RowDefinitions="Auto,Auto"
                                                  ColumnDefinitions="160,*"
                                                  RowSpacing="10">

                                                <TextBlock Grid.Row="0" Grid.Column="0"
                                                           Text="Health"
                                                           VerticalAlignment="Center" />
                                                <NumericUpDown Grid.Row="0" Grid.Column="1"
                                                               Value="{Binding PlayerEditor.Health}"
                                                               Minimum="0"
                                                               Increment="1"
                                                               FormatString="0" />

                                                <TextBlock Grid.Row="1" Grid.Column="0"
                                                           Text="Potion Fill"
                                                           VerticalAlignment="Center" />
                                                <NumericUpDown Grid.Row="1" Grid.Column="1"
                                                               Value="{Binding PlayerEditor.PotionFill}"
                                                               Minimum="0"
                                                               Increment="0.5"
                                                               FormatString="0.0" />
                                            </Grid>

                                            <Button Content="Apply Player Stats"
                                                    Command="{Binding PlayerEditor.ApplyPlayerStatsCommand}" />

                                            <!-- Separator -->
                                            <Border Height="1"
                                                    Background="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                                    Margin="0,4" />

                                            <!-- Info section -->
                                            <TextBlock Text="Session Info"
                                                       FontSize="15"
                                                       FontWeight="SemiBold" />

                                            <Grid RowDefinitions="Auto,Auto"
                                                  ColumnDefinitions="160,*"
                                                  RowSpacing="10">

                                                <TextBlock Grid.Row="0" Grid.Column="0"
                                                           Text="Checkpoint"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="0" Grid.Column="1"
                                                           Text="{Binding PlayerEditor.CheckpointDisplay}"
                                                           VerticalAlignment="Center"
                                                           FontFamily="Cascadia Code,Consolas,Courier New"
                                                           FontSize="12"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding PlayerEditor.CheckpointDisplay}" />

                                                <TextBlock Grid.Row="1" Grid.Column="0"
                                                           Text="Played Time"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="1" Grid.Column="1"
                                                           Text="{Binding PlayerEditor.PlayedTimeDisplay}"
                                                           VerticalAlignment="Center" />
                                            </Grid>

                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>

                                <!-- JSON tab -->
                                <TabItem Header="JSON">
                                    <DockPanel>

                                        <!-- Search bar -->
                                        <Border DockPanel.Dock="Top"
                                                Padding="6,4"
                                                BorderThickness="0,0,0,1"
                                                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                                            <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                                                  ColumnSpacing="4">
                                                <TextBox Grid.Column="0"
                                                         Text="{Binding JsonSearch}"
                                                         PlaceholderText="Search JSON…"
                                                         FontSize="13" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding SearchResultText}"
                                                           VerticalAlignment="Center"
                                                           FontSize="12"
                                                           Opacity="0.6"
                                                           MinWidth="64"
                                                           TextAlignment="Center" />
                                                <Button Grid.Column="2"
                                                        Content="↑"
                                                        Command="{Binding FindPreviousCommand}"
                                                        ToolTip.Tip="Previous match (Shift+Enter)" />
                                                <Button Grid.Column="3"
                                                        Content="↓"
                                                        Command="{Binding FindNextCommand}"
                                                        ToolTip.Tip="Next match (Enter)" />
                                            </Grid>
                                        </Border>

                                        <TextBox Text="{Binding JsonText}"
                                                 SelectionStart="{Binding JsonSelectionStart}"
                                                 SelectionEnd="{Binding JsonSelectionEnd}"
                                                 b:ScrollToSelectionBehavior.Anchor="{Binding JsonSelectionStart}"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 FontFamily="Cascadia Code,Consolas,Courier New"
                                                 FontSize="13" />
                                    </DockPanel>
                                </TabItem>

                                <!-- Overview tab -->
                                <TabItem Header="Overview">
                                    <ScrollViewer Padding="16">
                                        <StackPanel Spacing="20" MaxWidth="480" HorizontalAlignment="Left">

                                            <TextBlock Text="Document"
                                                       FontSize="15"
                                                       FontWeight="SemiBold" />

                                            <Grid RowDefinitions="Auto,Auto,Auto"
                                                  ColumnDefinitions="160,*"
                                                  RowSpacing="10">
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Version" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SaveVersion}" VerticalAlignment="Center" />

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Format" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FormatDisplay}" VerticalAlignment="Center" />

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Save ID" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="2" Grid.Column="1"
                                                           Text="{Binding SaveId}"
                                                           VerticalAlignment="Center"
                                                           FontFamily="Cascadia Code,Consolas,Courier New"
                                                           FontSize="12"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding SaveId}" />
                                            </Grid>

                                            <Border Height="1"
                                                    Background="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                                    Margin="0,4" />

                                            <TextBlock Text="World"
                                                       FontSize="15"
                                                       FontWeight="SemiBold" />

                                            <Grid RowDefinitions="Auto,Auto,Auto"
                                                  ColumnDefinitions="160,*"
                                                  RowSpacing="10">
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Data Entries" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding WorldDataEntryCount}" VerticalAlignment="Center" />

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Game Mode" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GameModeDisplay}" VerticalAlignment="Center" />

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Permadeath" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Permadeath}" VerticalAlignment="Center" />
                                            </Grid>

                                            <Border Height="1"
                                                    Background="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                                    Margin="0,4" />

                                            <TextBlock Text="Binary Data"
                                                       FontSize="15"
                                                       FontWeight="SemiBold" />

                                            <Grid RowDefinitions="Auto,Auto"
                                                  ColumnDefinitions="160,*"
                                                  RowSpacing="10">
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Event Log" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="0" Grid.Column="1"
                                                           Text="{Binding HasEventLog}"
                                                           VerticalAlignment="Center" />

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Map Fog" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="1" Grid.Column="1"
                                                           Text="{Binding HasMapFog}"
                                                           VerticalAlignment="Center" />
                                            </Grid>

                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>

                                <!-- Backups tab -->
                                <TabItem Header="Backups">
                                    <DockPanel Margin="16,8">

                                        <!-- Header -->
                                        <Grid DockPanel.Dock="Top"
                                              ColumnDefinitions="*,Auto"
                                              Margin="0,0,0,12">
                                            <TextBlock Grid.Column="0"
                                                       Text="Backup History"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                            <Button Grid.Column="1"
                                                    Content="Refresh"
                                                    Command="{Binding BackupsTab.RefreshCommand}" />
                                        </Grid>

                                        <!-- Status (empty / loading) -->
                                        <TextBlock DockPanel.Dock="Top"
                                                   Text="{Binding BackupsTab.StatusText}"
                                                   IsVisible="{Binding !BackupsTab.ShowList}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Opacity="0.5"
                                                   Margin="0,32,0,0" />

                                        <!-- Backup list -->
                                        <ScrollViewer IsVisible="{Binding BackupsTab.ShowList}">
                                            <ItemsControl ItemsSource="{Binding BackupsTab.Entries}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="editors:BackupEntryViewModel">
                                                        <Border Padding="8,8"
                                                                Margin="0,0,0,1"
                                                                BorderThickness="0,0,0,1"
                                                                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <StackPanel Grid.Column="0"
                                                                            Spacing="2"
                                                                            VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding DateDisplay}"
                                                                               FontWeight="Medium" />
                                                                    <TextBlock Text="{Binding SizeDisplay}"
                                                                               FontSize="12"
                                                                               Opacity="0.55" />
                                                                </StackPanel>
                                                                <Button Grid.Column="1"
                                                                        Content="Restore"
                                                                        Command="{Binding RestoreCommand}"
                                                                        VerticalAlignment="Center" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>

                                    </DockPanel>
                                </TabItem>

                            </TabControl>

                        </DockPanel>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>

        </Grid>
    </DockPanel>
</Window>
