<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ConstanceSaveEditor.UI.ViewModels"
        xmlns:editors="using:ConstanceSaveEditor.UI.ViewModels.Editors"
        xmlns:b="using:ConstanceSaveEditor.UI.Behaviors"
        xmlns:core="using:ConstanceSaveEditor.Core.Editing"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="ConstanceSaveEditor.UI.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Width="1200" Height="800"
        MinWidth="600" MinHeight="400">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
    </Window.KeyBindings>

    <DockPanel>

        <!-- Menu bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="{DynamicResource Menu.File}">
                <MenuItem Header="{DynamicResource Menu.Open}"
                          Command="{Binding OpenCommand}"
                          InputGesture="Ctrl+O" />
                <MenuItem Header="{DynamicResource Menu.Save}"
                          Command="{Binding SaveCommand}"
                          InputGesture="Ctrl+S" />
                <MenuItem Header="{DynamicResource Menu.SaveAs}"
                          Command="{Binding SaveAsCommand}"
                          InputGesture="Ctrl+Shift+S" />
                <Separator />
                <MenuItem Header="{DynamicResource Menu.RecentFiles}"
                          IsEnabled="{Binding HasRecentFiles}"
                          ItemsSource="{Binding RecentFiles}" />
                <Separator />
                <MenuItem Header="{DynamicResource Menu.Close}"
                          Command="{Binding CloseCommand}" />
                <Separator />
                <MenuItem Header="{DynamicResource Menu.Exit}"
                          Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="{DynamicResource Menu.View}">
                <MenuItem Header="{DynamicResource Menu.Theme}">
                    <MenuItem Header="{DynamicResource Menu.Theme.System}"
                              Command="{Binding SetThemeCommand}"
                              CommandParameter="System" />
                    <MenuItem Header="{DynamicResource Menu.Theme.Light}"
                              Command="{Binding SetThemeCommand}"
                              CommandParameter="Light" />
                    <MenuItem Header="{DynamicResource Menu.Theme.Dark}"
                              Command="{Binding SetThemeCommand}"
                              CommandParameter="Dark" />
                </MenuItem>
                <MenuItem Header="{DynamicResource Menu.Language}">
                    <MenuItem Header="{DynamicResource Menu.Language.English}"
                              Command="{Binding SetLanguageCommand}"
                              CommandParameter="en" />
                    <MenuItem Header="{DynamicResource Menu.Language.German}"
                              Command="{Binding SetLanguageCommand}"
                              CommandParameter="de" />
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- Status bar -->
        <Grid DockPanel.Dock="Bottom"
              ColumnDefinitions="*,Auto"
              Margin="8,4">
            <TextBlock Grid.Column="0"
                       Text="{Binding FileStatusText}"
                       FontSize="12"
                       Opacity="0.7"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1"
                       Text="{Binding StatusMessage}"
                       FontSize="12"
                       Margin="16,0,0,0" />
        </Grid>

        <!-- Main content -->
        <Grid>

            <!-- No file open -->
            <StackPanel IsVisible="{Binding NoFileOpen}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">
                <TextBlock Text="{DynamicResource NoFile.Prompt}"
                           FontSize="20"
                           Opacity="0.5"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{DynamicResource NoFile.Hint}"
                           FontSize="14"
                           Opacity="0.35"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Editor -->
            <ContentControl IsVisible="{Binding HasOpenFile}"
                            Content="{Binding CurrentEditor}">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:SaveEditorViewModel">
                        <DockPanel>

                            <!-- Info strip -->
                            <Border DockPanel.Dock="Top"
                                    Padding="12,8,12,8"
                                    BorderThickness="0,0,0,1"
                                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{Binding SourcePath}"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding SourcePath}" />
                                        <StackPanel Orientation="Horizontal" Spacing="16">
                                            <TextBlock Text="{Binding FormatDisplay}"
                                                       FontSize="12"
                                                       Opacity="0.6" />
                                            <TextBlock Text="{Binding LoadedAtDisplay}"
                                                       FontSize="12"
                                                       Opacity="0.6" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="{DynamicResource Button.Revert}"
                                            Command="{Binding RevertCommand}"
                                            IsEnabled="{Binding IsDirty}"
                                            VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Tabs -->
                            <TabControl>

                                <!-- Player tab -->
                                <TabItem Header="{DynamicResource Tab.Player}">
                                    <ScrollViewer Padding="16">
                                        <StackPanel Spacing="20" MaxWidth="480" HorizontalAlignment="Left">

                                            <!-- Currency section -->
                                            <TextBlock Text="{DynamicResource Player.Currency.Title}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold" />

                                            <Grid RowDefinitions="Auto,Auto,Auto"
                                                  ColumnDefinitions="160,*"
                                                  RowSpacing="10">

                                                <TextBlock Grid.Row="0" Grid.Column="0"
                                                           Text="{DynamicResource Player.Currency.Balance}"
                                                           VerticalAlignment="Center" />
                                                <NumericUpDown Grid.Row="0" Grid.Column="1"
                                                               Value="{Binding PlayerEditor.Balance}"
                                                               Minimum="0"
                                                               Increment="1000"
                                                               FormatString="0" />

                                                <TextBlock Grid.Row="1" Grid.Column="0"
                                                           Text="{DynamicResource Player.Currency.TotalCollected}"
                                                           VerticalAlignment="Center" />
                                                <NumericUpDown Grid.Row="1" Grid.Column="1"
                                                               Value="{Binding PlayerEditor.TotalCollected}"
                                                               Minimum="0"
                                                               Increment="1000"
                                                               FormatString="0" />

                                                <TextBlock Grid.Row="2" Grid.Column="0"
                                                           Text="{DynamicResource Player.Currency.AllTimeGlimmer}"
                                                           VerticalAlignment="Center" />
                                                <NumericUpDown Grid.Row="2" Grid.Column="1"
                                                               Value="{Binding PlayerEditor.AllTimeGlimmer}"
                                                               Minimum="0"
                                                               Increment="1000"
                                                               FormatString="0" />
                                            </Grid>

                                            <TextBlock Text="{DynamicResource Player.Currency.Warning}"
                                                       FontSize="11"
                                                       Opacity="0.5"
                                                       TextWrapping="Wrap" />

                                            <Button Content="{DynamicResource Player.Currency.Apply}"
                                                    Command="{Binding PlayerEditor.ApplyChangesCommand}" />

                                            <TextBlock Text="{Binding PlayerEditor.ValidationMessage}"
                                                       FontSize="12"
                                                       Foreground="Orange"
                                                       IsVisible="{Binding PlayerEditor.ValidationMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                       TextWrapping="Wrap" />

                                            <!-- Separator -->
                                            <Border Height="1"
                                                    Background="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                                    Margin="0,4" />

                                            <!-- Player stats section -->
                                            <TextBlock Text="{DynamicResource Player.Stats.Title}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold" />

                                            <Grid RowDefinitions="Auto,Auto"
                                                  ColumnDefinitions="160,*"
                                                  RowSpacing="10">

                                                <TextBlock Grid.Row="0" Grid.Column="0"
                                                           Text="{DynamicResource Player.Stats.Health}"
                                                           VerticalAlignment="Center" />
                                                <NumericUpDown Grid.Row="0" Grid.Column="1"
                                                               Value="{Binding PlayerEditor.Health}"
                                                               Minimum="0"
                                                               Increment="1"
                                                               FormatString="0" />

                                                <TextBlock Grid.Row="1" Grid.Column="0"
                                                           Text="{DynamicResource Player.Stats.PotionFill}"
                                                           VerticalAlignment="Center" />
                                                <NumericUpDown Grid.Row="1" Grid.Column="1"
                                                               Value="{Binding PlayerEditor.PotionFill}"
                                                               Minimum="0"
                                                               Increment="0.5"
                                                               FormatString="0.0" />
                                            </Grid>

                                            <Button Content="{DynamicResource Player.Stats.Apply}"
                                                    Command="{Binding PlayerEditor.ApplyPlayerStatsCommand}" />

                                            <!-- Separator -->
                                            <Border Height="1"
                                                    Background="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                                    Margin="0,4" />

                                            <!-- Info section -->
                                            <TextBlock Text="{DynamicResource Player.Session.Title}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold" />

                                            <Grid RowDefinitions="Auto,Auto"
                                                  ColumnDefinitions="160,*"
                                                  RowSpacing="10">

                                                <TextBlock Grid.Row="0" Grid.Column="0"
                                                           Text="{DynamicResource Player.Session.Checkpoint}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="0" Grid.Column="1"
                                                           Text="{Binding PlayerEditor.CheckpointDisplay}"
                                                           VerticalAlignment="Center"
                                                           FontFamily="Cascadia Code,Consolas,Courier New"
                                                           FontSize="12"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding PlayerEditor.CheckpointDisplay}" />

                                                <TextBlock Grid.Row="1" Grid.Column="0"
                                                           Text="{DynamicResource Player.Session.PlayedTime}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="1" Grid.Column="1"
                                                           Text="{Binding PlayerEditor.PlayedTimeDisplay}"
                                                           VerticalAlignment="Center" />
                                            </Grid>

                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>

                                <!-- Progress tab -->
                                <TabItem Header="{DynamicResource Tab.Progress}">
                                    <ScrollViewer Padding="16">
                                        <StackPanel Spacing="20" MaxWidth="560" HorizontalAlignment="Left">

                                            <!-- Collectibles -->
                                            <TextBlock Text="{DynamicResource Progress.Collectibles.Title}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold" />

                                            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                                  ColumnDefinitions="160,*"
                                                  RowSpacing="10">

                                                <TextBlock Grid.Row="0" Grid.Column="0"
                                                           Text="{DynamicResource Progress.Collectibles.HeartPieces}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="0" Grid.Column="1"
                                                           Text="{Binding ProgressTab.HeartPiecesDisplay}"
                                                           VerticalAlignment="Center" />

                                                <TextBlock Grid.Row="1" Grid.Column="0"
                                                           Text="{DynamicResource Progress.Collectibles.PaintFlasks}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="1" Grid.Column="1"
                                                           Text="{Binding ProgressTab.PaintFlasksDisplay}"
                                                           VerticalAlignment="Center" />

                                                <TextBlock Grid.Row="2" Grid.Column="0"
                                                           Text="{DynamicResource Progress.Collectibles.Polaroids}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="2" Grid.Column="1"
                                                           Text="{Binding ProgressTab.PolaroidsDisplay}"
                                                           VerticalAlignment="Center" />

                                                <TextBlock Grid.Row="3" Grid.Column="0"
                                                           Text="{DynamicResource Progress.Collectibles.Erasers}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="3" Grid.Column="1"
                                                           Text="{Binding ProgressTab.Erasers}"
                                                           VerticalAlignment="Center" />

                                                <TextBlock Grid.Row="4" Grid.Column="0"
                                                           Text="{DynamicResource Progress.Collectibles.LightStones}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="4" Grid.Column="1"
                                                           Text="{Binding ProgressTab.LightStones}"
                                                           VerticalAlignment="Center" />
                                            </Grid>

                                            <Border Height="1"
                                                    Background="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                                    Margin="0,4" />

                                            <!-- Completion -->
                                            <TextBlock Text="{DynamicResource Progress.Missing.Title}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold" />

                                            <Grid ColumnDefinitions="160,*">
                                                <TextBlock Grid.Column="0"
                                                           Text="{DynamicResource Progress.Missing.Summary.Label}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding ProgressTab.CompletionSummary}"
                                                           VerticalAlignment="Center" />
                                            </Grid>

                                            <ItemsControl ItemsSource="{Binding ProgressTab.Regions}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="editors:RegionRow">
                                                        <Grid ColumnDefinitions="160,80,*" Margin="0,2">
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding Name}"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding Percent, StringFormat='{}{0} %'}"
                                                                       HorizontalAlignment="Right"
                                                                       FontWeight="SemiBold"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding Counts}"
                                                                       Opacity="0.6"
                                                                       Margin="12,0,0,0"
                                                                       VerticalAlignment="Center" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Missing list -->
                                            <TextBlock Text="{DynamicResource Progress.Missing.ListTitle}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Opacity="0.6" />

                                            <TextBlock Text="{DynamicResource Progress.Missing.Empty}"
                                                       Opacity="0.6"
                                                       IsVisible="{Binding !ProgressTab.MissingItems.Count}" />

                                            <ItemsControl ItemsSource="{Binding ProgressTab.MissingItems}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="editors:MissingItem">
                                                        <Grid ColumnDefinitions="160,80,*" Margin="0,2">
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding Region}"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding Room}"
                                                                       FontWeight="SemiBold"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding Category}"
                                                                       Opacity="0.7"
                                                                       VerticalAlignment="Center" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <Border Height="1"
                                                    Background="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                                    Margin="0,4" />

                                            <!-- Inspirations -->
                                            <TextBlock Text="{DynamicResource Progress.Inspirations.Title}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold" />

                                            <Grid ColumnDefinitions="160,*"
                                                  RowDefinitions="Auto">
                                                <TextBlock Grid.Column="0"
                                                           Text="{DynamicResource Progress.Inspirations.Summary.Label}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding ProgressTab.InspirationsSummary}"
                                                           VerticalAlignment="Center" />
                                            </Grid>

                                            <!-- Inspiration list header -->
                                            <Grid ColumnDefinitions="*,80,80">
                                                <TextBlock Grid.Column="0"
                                                           Text="{DynamicResource Progress.Inspirations.Name}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Opacity="0.6" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{DynamicResource Progress.Inspirations.Collected}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Opacity="0.6"
                                                           HorizontalAlignment="Center" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{DynamicResource Progress.Inspirations.Upgraded}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Opacity="0.6"
                                                           HorizontalAlignment="Center" />
                                            </Grid>

                                            <ItemsControl ItemsSource="{Binding ProgressTab.Inspirations}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="core:InspirationEntry">
                                                        <Grid ColumnDefinitions="*,80,80"
                                                              Margin="0,2">
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding Name}"
                                                                       VerticalAlignment="Center" />

                                                            <TextBlock Grid.Column="1"
                                                                       Text="&#x2713;"
                                                                       IsVisible="{Binding IsCollected}"
                                                                       HorizontalAlignment="Center"
                                                                       Foreground="{DynamicResource SystemAccentColor}"
                                                                       FontWeight="SemiBold" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="&#x2013;"
                                                                       IsVisible="{Binding !IsCollected}"
                                                                       HorizontalAlignment="Center"
                                                                       Opacity="0.3" />

                                                            <TextBlock Grid.Column="2"
                                                                       Text="&#x2713;"
                                                                       IsVisible="{Binding IsUpgraded}"
                                                                       HorizontalAlignment="Center"
                                                                       Foreground="{DynamicResource SystemAccentColor}"
                                                                       FontWeight="SemiBold" />
                                                            <TextBlock Grid.Column="2"
                                                                       Text="&#x2013;"
                                                                       IsVisible="{Binding !IsUpgraded}"
                                                                       HorizontalAlignment="Center"
                                                                       Opacity="0.3" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <Border Height="1"
                                                    Background="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                                    Margin="0,4" />

                                            <!-- Stats -->
                                            <TextBlock Text="{DynamicResource Progress.Stats.Title}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold" />

                                            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                                  ColumnDefinitions="200,*"
                                                  RowSpacing="10">

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Progress.Stats.EnemiesKilled}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ProgressTab.EnemiesKilled}" VerticalAlignment="Center" />

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Progress.Stats.Dashes}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ProgressTab.DashCount}" VerticalAlignment="Center" />

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Progress.Stats.BrushHits}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ProgressTab.BrushHits}" VerticalAlignment="Center" />

                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource Progress.Stats.PaintThrown}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ProgressTab.SplooshCount}" VerticalAlignment="Center" />

                                                <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource Progress.Stats.DamageReceived}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ProgressTab.ReceivedDamage}" VerticalAlignment="Center" />

                                                <TextBlock Grid.Row="5" Grid.Column="0" Text="{DynamicResource Progress.Stats.Electrocuted}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ProgressTab.TimesElectrocuted}" VerticalAlignment="Center" />

                                                <TextBlock Grid.Row="6" Grid.Column="0" Text="{DynamicResource Progress.Stats.Persevered}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding ProgressTab.TimesPersevered}" VerticalAlignment="Center" />

                                                <TextBlock Grid.Row="7" Grid.Column="0" Text="{DynamicResource Progress.Stats.GameOvers}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding ProgressTab.GameOversByCorruption}" VerticalAlignment="Center" />

                                                <TextBlock Grid.Row="8" Grid.Column="0" Text="{DynamicResource Progress.Stats.Snapshots}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding ProgressTab.SnapshotsTaken}" VerticalAlignment="Center" />

                                                <TextBlock Grid.Row="9" Grid.Column="0" Text="{DynamicResource Progress.Stats.Clones}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding ProgressTab.ClonesUsed}" VerticalAlignment="Center" />

                                                <TextBlock Grid.Row="10" Grid.Column="0" Text="{DynamicResource Progress.Stats.ShrineVisits}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding ProgressTab.ShrineVisits}" VerticalAlignment="Center" />

                                                <TextBlock Grid.Row="11" Grid.Column="0" Text="{DynamicResource Progress.Stats.PetCat}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="11" Grid.Column="1" Text="{Binding ProgressTab.TimesPetCat}" VerticalAlignment="Center" />
                                            </Grid>

                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>

                                <!-- JSON tab -->
                                <TabItem Header="{DynamicResource Tab.JSON}">
                                    <DockPanel>

                                        <!-- Search bar -->
                                        <Border DockPanel.Dock="Top"
                                                Padding="6,4"
                                                BorderThickness="0,0,0,1"
                                                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                                            <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                                                  ColumnSpacing="4">
                                                <TextBox Grid.Column="0"
                                                         Text="{Binding JsonSearch}"
                                                         PlaceholderText="{DynamicResource JSON.Search.Placeholder}"
                                                         FontSize="13" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding SearchResultText}"
                                                           VerticalAlignment="Center"
                                                           FontSize="12"
                                                           Opacity="0.6"
                                                           MinWidth="64"
                                                           TextAlignment="Center" />
                                                <Button Grid.Column="2"
                                                        Content="&#x2191;"
                                                        Command="{Binding FindPreviousCommand}"
                                                        ToolTip.Tip="{DynamicResource JSON.Search.Previous}" />
                                                <Button Grid.Column="3"
                                                        Content="&#x2193;"
                                                        Command="{Binding FindNextCommand}"
                                                        ToolTip.Tip="{DynamicResource JSON.Search.Next}" />
                                            </Grid>
                                        </Border>

                                        <TextBox Text="{Binding JsonText}"
                                                 SelectionStart="{Binding JsonSelectionStart}"
                                                 SelectionEnd="{Binding JsonSelectionEnd}"
                                                 b:ScrollToSelectionBehavior.Anchor="{Binding JsonSelectionStart}"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 FontFamily="Cascadia Code,Consolas,Courier New"
                                                 FontSize="13" />
                                    </DockPanel>
                                </TabItem>

                                <!-- Overview tab -->
                                <TabItem Header="{DynamicResource Tab.Overview}">
                                    <ScrollViewer Padding="16">
                                        <StackPanel Spacing="20" MaxWidth="480" HorizontalAlignment="Left">

                                            <TextBlock Text="{DynamicResource Overview.Document.Title}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold" />

                                            <Grid RowDefinitions="Auto,Auto,Auto"
                                                  ColumnDefinitions="160,*"
                                                  RowSpacing="10">
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Overview.Document.Version}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SaveVersion}" VerticalAlignment="Center" />

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Overview.Document.Format}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FormatDisplay}" VerticalAlignment="Center" />

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Overview.Document.SaveId}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="2" Grid.Column="1"
                                                           Text="{Binding SaveId}"
                                                           VerticalAlignment="Center"
                                                           FontFamily="Cascadia Code,Consolas,Courier New"
                                                           FontSize="12"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding SaveId}" />
                                            </Grid>

                                            <Border Height="1"
                                                    Background="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                                    Margin="0,4" />

                                            <TextBlock Text="{DynamicResource Overview.World.Title}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold" />

                                            <Grid RowDefinitions="Auto,Auto,Auto"
                                                  ColumnDefinitions="160,*"
                                                  RowSpacing="10">
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Overview.World.DataEntries}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding WorldDataEntryCount}" VerticalAlignment="Center" />

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Overview.World.GameMode}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GameModeDisplay}" VerticalAlignment="Center" />

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Overview.World.Permadeath}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Permadeath}" VerticalAlignment="Center" />
                                            </Grid>

                                            <Border Height="1"
                                                    Background="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                                    Margin="0,4" />

                                            <TextBlock Text="{DynamicResource Overview.Binary.Title}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold" />

                                            <Grid RowDefinitions="Auto,Auto"
                                                  ColumnDefinitions="160,*"
                                                  RowSpacing="10">
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Overview.Binary.EventLog}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="0" Grid.Column="1"
                                                           Text="{Binding HasEventLog}"
                                                           VerticalAlignment="Center" />

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Overview.Binary.MapFog}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="1" Grid.Column="1"
                                                           Text="{Binding HasMapFog}"
                                                           VerticalAlignment="Center" />
                                            </Grid>

                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>

                                <!-- Backups tab -->
                                <TabItem Header="{DynamicResource Tab.Backups}">
                                    <DockPanel Margin="16,8">

                                        <!-- Header -->
                                        <Grid DockPanel.Dock="Top"
                                              ColumnDefinitions="*,Auto"
                                              Margin="0,0,0,12">
                                            <TextBlock Grid.Column="0"
                                                       Text="{DynamicResource Backups.Title}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                            <Button Grid.Column="1"
                                                    Content="{DynamicResource Backups.Refresh}"
                                                    Command="{Binding BackupsTab.RefreshCommand}" />
                                        </Grid>

                                        <!-- Status (empty / loading) -->
                                        <TextBlock DockPanel.Dock="Top"
                                                   Text="{Binding BackupsTab.StatusText}"
                                                   IsVisible="{Binding !BackupsTab.ShowList}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Opacity="0.5"
                                                   Margin="0,32,0,0" />

                                        <!-- Backup list -->
                                        <ScrollViewer IsVisible="{Binding BackupsTab.ShowList}">
                                            <ItemsControl ItemsSource="{Binding BackupsTab.Entries}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="editors:BackupEntryViewModel">
                                                        <Border Padding="8,8"
                                                                Margin="0,0,0,1"
                                                                BorderThickness="0,0,0,1"
                                                                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <StackPanel Grid.Column="0"
                                                                            Spacing="2"
                                                                            VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding DateDisplay}"
                                                                               FontWeight="Medium" />
                                                                    <TextBlock Text="{Binding SizeDisplay}"
                                                                               FontSize="12"
                                                                               Opacity="0.55" />
                                                                </StackPanel>
                                                                <Button Grid.Column="1"
                                                                        Content="{DynamicResource Backups.Restore}"
                                                                        Command="{Binding RestoreCommand}"
                                                                        VerticalAlignment="Center" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>

                                    </DockPanel>
                                </TabItem>

                            </TabControl>

                        </DockPanel>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>

        </Grid>
    </DockPanel>
</Window>
